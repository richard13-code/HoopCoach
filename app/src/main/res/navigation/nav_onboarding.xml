<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_onboarding"
    app:startDestination="@id/welcomeFragment3">

    <fragment
        android:id="@+id/welcomeFragment3"
        android:name="com.example.hoopcoach.WelcomeFragment"
        android:label="WelcomeFragment"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcomeFragment3_to_loginFragment2"
            app:destination="@id/loginFragment2" />
        <action
            android:id="@+id/action_welcomeFragment3_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment2"
        android:name="com.example.hoopcoach.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" />
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.hoopcoach.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_register"/>

</navigation>